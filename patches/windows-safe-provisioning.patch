new file mode 100644
index 0000000..ba8af63
--- /dev/null
+++ b/windows/setup-firstboot.ps1
@@ -0,0 +1,49 @@
+<# Local guest initialization only: no installer, remote server, update/security or IPv6 changes. #>
+[CmdletBinding()]
+param([Parameter(Mandatory=$true)][ValidateSet("Machine", "User")][string]$Phase)
+$ErrorActionPreference = "Stop"
+# The builder only stages this file. It is never run on the x64 build host.
+if ($env:PROCESSOR_ARCHITECTURE -ine "ARM64" -or
+    -not ([IO.Path]::GetFullPath($PSScriptRoot).TrimEnd('\').Equals("C:\DroidVM", [StringComparison]::OrdinalIgnoreCase))) {
+    throw "This initializer is only for the installed ARM64 guest"
+}
+function Invoke-GuestCommand([string]$Name, [string[]]$Arguments) {
+    & (Join-Path $env:SystemRoot ("System32\" + $Name + ".exe")) @Arguments
+    if ($LASTEXITCODE -ne 0) { throw "Guest initialization command failed: $Name" }
+}
+if ($Phase -eq "Machine") {
+    $certs = @(Get-ChildItem -LiteralPath (Join-Path $PSScriptRoot "certs") -File -Filter "*.cer")
+    if ($certs.Count -ne 1) { throw "The pinned guest driver certificate is missing or ambiguous" }
+    foreach ($cert in $certs) {
+        Invoke-GuestCommand "certutil" @("-addstore", "-f", "Root", $cert.FullName)
+        Invoke-GuestCommand "certutil" @("-addstore", "-f", "TrustedPublisher", $cert.FullName)
+    }
+    $winlogon = "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon"
+    Set-ItemProperty -LiteralPath $winlogon -Name AutoAdminLogon -Value "0"
+    Remove-ItemProperty -LiteralPath $winlogon -Name DefaultPassword -ErrorAction SilentlyContinue
+    Set-ItemProperty -LiteralPath "HKLM:\SYSTEM\CurrentControlSet\Control\Terminal Server" -Name fDenyTSConnections -Value 1
+    foreach ($rule in @(Get-NetFirewallRule -Name "RemoteDesktop-*" -ErrorAction SilentlyContinue)) {
+        Disable-NetFirewallRule -InputObject $rule
+    }
+    # The stock image has no SSH server; keep an already-present service closed as well.
+    foreach ($name in @("sshd")) {
+        $service = Get-Service -Name $name -ErrorAction SilentlyContinue
+        if ($service) {
+            if ($service.Status -ne "Stopped") { Stop-Service -Name $name -ErrorAction Stop }
+            Set-Service -Name $name -StartupType Disabled
+        }
+    }
+    foreach ($rule in @(Get-NetFirewallRule -Name "OpenSSH-Server-In-TCP", "DroidVM-sshd" -ErrorAction SilentlyContinue)) {
+        Disable-NetFirewallRule -InputObject $rule
+    }
+    return
+}
+# Preserve the required root-enumerated power device without invoking an installer wrapper.
+$pvm = Join-Path $PSScriptRoot "pvmpower-devnode.ps1"
+if (-not (Test-Path -LiteralPath $pvm -PathType Leaf)) { throw "pvmpower devnode initialization is missing" }
+& $pvm
+if (-not $?) { throw "pvmpower devnode initialization failed" }
+Invoke-GuestCommand "powercfg" @("/change", "standby-timeout-ac", "0")
+Invoke-GuestCommand "powercfg" @("/change", "standby-timeout-dc", "0")
+Invoke-GuestCommand "powercfg" @("/change", "monitor-timeout-ac", "0")
+Invoke-GuestCommand "powercfg" @("/change", "monitor-timeout-dc", "0")
