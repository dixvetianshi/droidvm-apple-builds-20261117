+    // The supplied real run_gunyah stack and its temporary outer IRQ clone drop before finish.
+    let run = std::panic::catch_unwind(std::panic::AssertUnwindSafe(run));
+    let close = fence.finish();
+    let errors = close.errors.into_iter().map(|error| anyhow!(error)).collect();
+    match run {
+        Ok(run) => combine_run_cleanup(run, errors),
+        Err(payload) => {
