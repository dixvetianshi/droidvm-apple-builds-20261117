new file mode 100644
--- /dev/null
+++ b/src/crosvm/sys/linux/run_control_lifecycle.rs
@@ -0,0 +1,121 @@
+// Copyright 2026 The ChromiumOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! The start gate for owner-fenced VMs. A partial vCPU spawn must be cancellable:
+//! a fixed Barrier cannot release the threads whose missing peers never started.
+
+use std::sync::Condvar;
+use std::sync::Mutex;
+
+#[derive(Copy, Clone, Eq, PartialEq)]
+enum GateState {
+    Waiting,
+    Released,
+    Cancelled,
+}
+
+pub struct StartGate {
+    state: Mutex<GateState>,
+    changed: Condvar,
+}
+
+impl StartGate {
+    pub fn new() -> Self {
+        Self { state: Mutex::new(GateState::Waiting), changed: Condvar::new() }
+    }
+
+    pub fn wait(&self) -> bool {
+        let mut state = self.state.lock().unwrap_or_else(|e| e.into_inner());
+        while *state == GateState::Waiting {
+            state = self.changed.wait(state).unwrap_or_else(|e| e.into_inner());
+        }
+        *state == GateState::Released
+    }
+
+    pub fn release(&self) {
+        let mut state = self.state.lock().unwrap_or_else(|e| e.into_inner());
+        if *state == GateState::Waiting {
+            *state = GateState::Released;
+            self.changed.notify_all();
+        }
+    }
+
+    pub fn cancel(&self) {
+        let mut state = self.state.lock().unwrap_or_else(|e| e.into_inner());
+        if *state == GateState::Waiting {
+            *state = GateState::Cancelled;
+            self.changed.notify_all();
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::StartGate;
+    use std::sync::mpsc;
+    use std::sync::Arc;
+    use std::thread;
+    use std::time::Duration;
+
+    #[test]
+    fn partial_spawn_cancellation_joins_actual_waiting_threads() {
+        let gate = Arc::new(StartGate::new());
+        let (ready, receiver) = mpsc::channel();
+        let mut handles = Vec::new();
+        for _ in 0..2 {
+            let gate = gate.clone();
+            let ready = ready.clone();
+            handles.push(thread::spawn(move || {
+                ready.send(()).unwrap();
+                assert!(!gate.wait());
+            }));
+        }
+        for _ in 0..2 {
+            receiver.recv_timeout(Duration::from_secs(1)).unwrap();
+        }
+        // The third spawn failed: cancellation needs no third participant.
+        gate.cancel();
+        for handle in handles { handle.join().unwrap(); }
+        gate.release();
+        assert!(!gate.wait());
+    }
+
+    #[test]
+    fn release_before_arrival_does_not_leave_late_threads_waiting() {
+        let gate = Arc::new(StartGate::new());
+        gate.release();
+        let handle = thread::spawn(move || assert!(gate.wait()));
+        handle.join().unwrap();
+    }
+
+    #[test]
+    fn cancel_after_release_does_not_revoke_a_started_vcpu() {
+        let gate = StartGate::new();
+        gate.release();
+        gate.cancel();
+        assert!(gate.wait());
+    }
+
+    #[test]
+    fn missing_one_shot_handshake_cancels_peers_without_waiting_for_a_missing_vcpu() {
+        let gate = Arc::new(StartGate::new());
+        let (sender, receiver) = mpsc::channel();
+        let failed_sender = sender.clone();
+        let failed = thread::spawn(move || drop(failed_sender));
+        let peer_sender = sender.clone();
+        let peer_gate = gate.clone();
+        let peer = thread::spawn(move || {
+            peer_sender.send(1).unwrap();
+            drop(peer_sender);
+            assert!(!peer_gate.wait());
+        });
+        drop(sender);
+        assert_eq!(receiver.recv_timeout(Duration::from_secs(1)).unwrap(), 1);
+        assert!(matches!(receiver.recv_timeout(Duration::from_secs(1)),
+                         Err(mpsc::RecvTimeoutError::Disconnected)));
+        gate.cancel();
+        failed.join().unwrap();
+        peer.join().unwrap();
+    }
+}
