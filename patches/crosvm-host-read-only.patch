--- /dev/null
+++ b/hypervisor/src/gunyah/lease.rs
@@ -0,0 +1,266 @@
+// Copyright 2026 The ChromiumOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! App-private HostShare lease client. The owner fence keeps monitor fds only;
+//! VM/IRQ/device/memory owners must leave their scopes before completion is read.
+
+#[path = "lease_state.rs"]
+mod lease_state;
+
+use std::cell::RefCell;
+use std::fs::File;
+use std::fs::OpenOptions;
+use std::os::fd::AsRawFd;
+use std::os::fd::FromRawFd;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::time::Duration;
+
+use base::ioctl;
+use base::ioctl_with_mut_ref;
+use base::ioctl_with_ref;
+use base::Error;
+use base::Result;
+
+use super::gunyah_sys::ghsm_share_blob;
+use super::gunyah_sys::ghsm_share_dmabuf;
+use lease_state::Completion;
+use lease_state::CompletionTracker;
+use lease_state::LeaseCaps;
+use lease_state::LeaseStatus;
+
+pub const PROVIDER: &str = "/dev/gunyah_share";
+
+// Frozen owner header ghsm_lease_uapi.h SHA256
+// b2f34317da73b49867263bd664c969be1ce74bd33dad693a13ddaeb615c07a48.
+// Existing 0x14/0x15/0x16 structs above remain owned by gunyah_sys.
+#[repr(C)]
+struct OpenLease { vm_fd: i32, flags: u32 }
+#[repr(C)]
+struct ShareBlobLease { blob: ghsm_share_blob, lease_fd: i32, reserved: u32, parcel_id: u64 }
+#[repr(C)]
+struct ShareDmabufLease { blob: ghsm_share_dmabuf, lease_fd: i32, reserved: u32, parcel_id: u64 }
+#[repr(C)]
+struct UnshareParcel { parcel_id: u64 }
+
+base::ioctl_ior_nr!(GET_CAPS, 0x47, 0x20, LeaseCaps);
+base::ioctl_iow_nr!(OPEN_LEASE, 0x47, 0x21, OpenLease);
+base::ioctl_iowr_nr!(SHARE_BLOB, 0x47, 0x22, ShareBlobLease);
+base::ioctl_iowr_nr!(SHARE_DMABUF, 0x47, 0x23, ShareDmabufLease);
+base::ioctl_io_nr!(SEAL, 0x47, 0x24);
+base::ioctl_ior_nr!(QUERY, 0x47, 0x25, LeaseStatus);
+base::ioctl_iow_nr!(UNSHARE_PARCEL, 0x47, 0x26, UnshareParcel);
+
+fn error_from_io(error: std::io::Error) -> Error {
+    Error::new(error.raw_os_error().unwrap_or(libc::EIO))
+}
+
+fn checked_zero(ret: i32) -> Result<()> {
+    if ret == 0 { Ok(()) } else if ret < 0 { Err(Error::last()) }
+    else { Err(Error::new(libc::EPROTO)) }
+}
+
+fn query(fd: &File) -> Result<LeaseStatus> {
+    let mut status = LeaseStatus::default();
+    // SAFETY: repr(C), the owner header defines exactly this output layout.
+    checked_zero(unsafe { ioctl_with_mut_ref(fd, QUERY, &mut status) })?;
+    Ok(status)
+}
+
+fn seal(fd: &File) -> Result<()> {
+    // SAFETY: fd is an owned anonymous lease descriptor; no pointer argument.
+    checked_zero(unsafe { ioctl(fd, SEAL) })
+}
+
+struct Monitor { fd: File, generation: Option<u64>, identity_error: Option<String> }
+#[derive(Default)]
+struct Registry { monitors: Vec<Monitor> }
+
+thread_local! {
+    static ACTIVE: RefCell<Option<Arc<Mutex<Registry>>>> = const { RefCell::new(None) };
+}
+
+pub struct LeaseClient { provider: File, fd: File }
+
+impl LeaseClient {
+    pub fn open(vm_fd: i32) -> Result<Self> {
+        let registry = ACTIVE.with(|active| active.borrow().clone())
+            .ok_or_else(|| {
+                base::error!("private HostShare lease requires the outer owner close fence");
+                Error::new(libc::EPROTO)
+            })?;
+        let provider = OpenOptions::new().read(true).write(true).open(PROVIDER)
+            .map_err(error_from_io)?;
+        let mut caps = LeaseCaps::default();
+        // SAFETY: fixed header layout; the provider must advertise all required capabilities.
+        checked_zero(unsafe { ioctl_with_mut_ref(&provider, GET_CAPS, &mut caps) })?;
+        if !caps.supports_owner_fence() {
+            base::error!("private HostShare lacks required lease capabilities: {:?}", caps);
+            return Err(Error::new(libc::ENOTSUP));
+        }
+        let open = OpenLease { vm_fd, flags: 0 };
+        // SAFETY: caller retains the exact VM fd; OPEN returns a new CLOEXEC fd, including fd 0.
+        let ret = unsafe { ioctl_with_ref(&provider, OPEN_LEASE, &open) };
+        if ret < 0 { return Err(Error::last()); }
+        let monitor_fd = unsafe { File::from_raw_fd(ret) };
+        // Register the owned descriptor BEFORE any fallible duplicate/query and BEFORE SHARE.
+        // A failed boot can therefore seal a context even if no LeaseClient was returned.
+        let (index, fd) = {
+            let mut registry = registry.lock().unwrap_or_else(|e| e.into_inner());
+            let index = registry.monitors.len();
+            registry.monitors.push(Monitor { fd: monitor_fd, generation: None, identity_error: None });
+            let fd = registry.monitors[index].fd.try_clone().map_err(error_from_io)?;
+            (index, fd)
+        };
+        let status = query(&fd)?;
+        if status.version != lease_state::ABI_VERSION || status.generation == 0
+            || status.state != lease_state::OPEN || status.owned_maps != 0
+            || status.inflight_shares != 0 {
+            base::error!("new private HostShare lease returned unexpected identity/state: {:?}", status);
+            registry.lock().unwrap_or_else(|e| e.into_inner()).monitors[index].identity_error =
+                Some(format!("new lease identity/state was invalid: {:?}", status));
+            return Err(Error::new(libc::EPROTO));
+        }
+        registry.lock().unwrap_or_else(|e| e.into_inner()).monitors[index].generation =
+            Some(status.generation);
+        Ok(Self { provider, fd })
+    }
+
+    pub fn share_blob(&self, blob: &mut ghsm_share_blob) -> Result<u64> {
+        let mut request = ShareBlobLease {
+            blob: *blob, lease_fd: self.fd.as_raw_fd(), reserved: 0, parcel_id: 0,
+        };
+        // SAFETY: fixed owner header; the returned parcel id belongs to this exact lease fd.
+        checked_zero(unsafe { ioctl_with_mut_ref(&self.provider, SHARE_BLOB, &mut request) })?;
+        *blob = request.blob;
+        Ok(request.parcel_id)
+    }
+
+    pub fn share_dmabuf(&self, blob: &mut ghsm_share_dmabuf) -> Result<u64> {
+        let mut request = ShareDmabufLease {
+            blob: *blob, lease_fd: self.fd.as_raw_fd(), reserved: 0, parcel_id: 0,
+        };
+        checked_zero(unsafe { ioctl_with_mut_ref(&self.provider, SHARE_DMABUF, &mut request) })?;
+        *blob = request.blob;
+        Ok(request.parcel_id)
+    }
+
+    pub fn unshare(&self, parcel_id: u64) -> Result<()> {
+        let request = UnshareParcel { parcel_id };
+        // 0 is the only exact-token reclaim/free ack. EAGAIN, ENOENT and every error remain unknown.
+        checked_zero(unsafe { ioctl_with_ref(&self.fd, UNSHARE_PARCEL, &request) })
+    }
+
+    pub fn seal(&self) -> Result<()> { seal(&self.fd) }
+}
+
+#[derive(Debug, Default)]
+pub struct CloseReport {
+    pub completed_generations: Vec<u64>,
+    pub errors: Vec<String>,
+}
+
+impl CloseReport {
+    pub fn is_clean(&self) -> bool { self.errors.is_empty() }
+}
+
+/// Lives OUTSIDE run_gunyah. Its registry owns lease fds and scalar identity only.
+/// Hard abort/_exit/SIGKILL do not unwind this guard and remain explicitly unsupported.
+pub struct OwnerFence { registry: Arc<Mutex<Registry>>, closed: bool, owner_pid: u32 }
+
+impl OwnerFence {
+    pub fn begin() -> Result<Self> {
+        let registry = Arc::new(Mutex::new(Registry::default()));
+        ACTIVE.with(|active| {
+            let mut active = active.borrow_mut();
+            if active.is_some() { return Err(Error::new(libc::EBUSY)); }
+            *active = Some(registry.clone());
+            Ok(())
+        })?;
+        Ok(Self { registry, closed: false, owner_pid: std::process::id() })
+    }
+
+    /// Returns only after actual COMPLETE for EVERY opened lease. Failures are reported while
+    /// the same owner PID stays alive; no deadline, elapsed wait, poll flag or ENOENT is an ack.
+    pub fn finish(&mut self) -> CloseReport {
+        let monitors = {
+            let mut registry = self.registry.lock().unwrap_or_else(|e| e.into_inner());
+            std::mem::take(&mut registry.monitors)
+        };
+        let mut report = CloseReport::default();
+        for monitor in monitors {
+            let mut tracker = CompletionTracker::new(monitor.generation);
+            if let Some(error) = monitor.identity_error { tracker.reject_identity(error); }
+            tracker.requested_close();
+            let mut reported = std::collections::BTreeSet::new();
+            let mut last_status = None;
+            let mut record = |operation: &'static str, error: String| {
+                if reported.insert(operation) {
+                    base::error!("owner PID {} retained: lease {}: {}", self.owner_pid, operation, error);
+                    report.errors.push(format!("{}: {}", operation, error));
+                }
+            };
+            loop {
+                if let Err(error) = seal(&monitor.fd) {
+                    if error.errno() != libc::EAGAIN && error.errno() != libc::EINTR {
+                        record("seal", error.to_string());
+                    }
+                }
+                let mut paced = false;
+                match query(&monitor.fd) {
+                    Ok(status) => {
+                        if last_status != Some(status) {
+                            base::info!("owner PID {} HostShare close: {:?}", self.owner_pid, status);
+                            last_status = Some(status);
+                        }
+                        match tracker.observe(status) {
+                            Completion::Complete => {
+                                report.completed_generations.push(status.generation);
+                                break;
+                            }
+                            Completion::Hold(error) => { record("state", error); paced = true; }
+                            Completion::Pending => {}
+                        }
+                    }
+                    Err(error) => { record("query", error.to_string()); paced = true; }
+                }
+                if paced {
+                    // Error backoff only. This delay acknowledges NOTHING; a fresh QUERY follows.
+                    // STALLED's persistent POLLERR must not turn retention into a busy loop.
+                    std::thread::park_timeout(Duration::from_secs(1));
+                    continue;
+                }
+                let mut pollfd = libc::pollfd {
+                    fd: monitor.fd.as_raw_fd(), events: libc::POLLIN, revents: 0,
+                };
+                // Notification/timeout only wake the next QUERY; neither proves completion.
+                let ret = unsafe { libc::poll(&mut pollfd, 1, 1000) };
+                if ret < 0 {
+                    let error = Error::last();
+                    if error.errno() != libc::EINTR { record("poll", error.to_string()); }
+                } else if pollfd.revents & (libc::POLLERR | libc::POLLHUP | libc::POLLNVAL) != 0 {
+                    record("poll", format!("notification is not completion: revents={:#x}", pollfd.revents));
+                    std::thread::park_timeout(Duration::from_secs(1));
+                }
+            }
+        }
+        self.closed = true;
+        report
+    }
+}
+
+impl Drop for OwnerFence {
+    fn drop(&mut self) {
+        if !self.closed {
+            let report = self.finish();
+            if !report.is_clean() { base::error!("HostShare close fence errors: {:?}", report); }
+        }
+        ACTIVE.with(|active| {
+            let mut active = active.borrow_mut();
+            if active.as_ref().map_or(false, |current| Arc::ptr_eq(current, &self.registry)) {
+                *active = None;
+            }
+        });
+    }
+}
diff --git a/hypervisor/src/gunyah/lease_state.rs b/hypervisor/src/gunyah/lease_state.rs
new file mode 100644
--- /dev/null
+++ b/hypervisor/src/gunyah/lease_state.rs
@@ -0,0 +1,143 @@
+// Copyright 2026 The ChromiumOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! Facts from the frozen ghsm_lease_uapi.h, plus the completion boundary.
+//! No VM, GuestMemory, mapping or host process object is retained here.
+
+pub const ABI_VERSION: u32 = 1;
+pub const REQUIRED_FEATURES: u64 = 0xf;
+pub const OPEN: u32 = 1;
+pub const CLOSING: u32 = 2;
+pub const COMPLETE: u32 = 3;
+pub const STALLED: u32 = 4;
+
+#[repr(C)]
+#[derive(Copy, Clone, Debug, Default)]
+pub struct LeaseCaps {
+    pub version: u32,
+    pub reserved: u32,
+    pub features: u64,
+}
+
+impl LeaseCaps {
+    pub fn supports_owner_fence(&self) -> bool {
+        self.version == ABI_VERSION && self.reserved == 0
+            && self.features & REQUIRED_FEATURES == REQUIRED_FEATURES
+    }
+}
+
+#[repr(C)]
+#[derive(Copy, Clone, Debug, Default, Eq, PartialEq)]
+pub struct LeaseStatus {
+    pub version: u32,
+    pub state: u32,
+    pub generation: u64,
+    pub owned_maps: u64,
+    pub inflight_shares: u32,
+    pub last_errno: i32,
+}
+
+#[derive(Debug, Eq, PartialEq)]
+pub enum Completion {
+    Pending,
+    Complete,
+    Hold(String),
+}
+
+pub struct CompletionTracker {
+    generation: Option<u64>,
+    close_requested: bool,
+    identity_error: Option<String>,
+}
+
+impl CompletionTracker {
+    pub fn new(generation: Option<u64>) -> Self {
+        Self { generation, close_requested: false, identity_error: None }
+    }
+
+    pub fn requested_close(&mut self) { self.close_requested = true; }
+
+    pub fn reject_identity(&mut self, error: String) { self.identity_error = Some(error); }
+
+    pub fn observe(&mut self, status: LeaseStatus) -> Completion {
+        if let Some(error) = &self.identity_error {
+            return Completion::Hold(error.clone());
+        }
+        let malformed = if status.version != ABI_VERSION || status.generation == 0 {
+            Some(format!("unrecognized lease identity: {:?}", status))
+        } else if self.generation.map_or(false, |expected| expected != status.generation) {
+            Some(format!("lease generation changed: expected {:?}, got {:?}",
+                         self.generation, status))
+        } else if !matches!(status.state, OPEN | CLOSING | COMPLETE | STALLED) {
+            Some(format!("unrecognized lease state: {:?}", status))
+        } else if status.state == COMPLETE
+            && (!self.close_requested || status.owned_maps != 0 || status.inflight_shares != 0) {
+            Some(format!("contradictory completion: {:?}", status))
+        } else { None };
+        if let Some(error) = malformed {
+            self.identity_error = Some(error.clone());
+            return Completion::Hold(error);
+        }
+        self.generation.get_or_insert(status.generation);
+        match status.state {
+            COMPLETE => Completion::Complete,
+            STALLED => Completion::Hold(format!("reclaim stalled; resources still owned: {:?}", status)),
+            _ => Completion::Pending,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn status(state: u32, maps: u64, inflight: u32) -> LeaseStatus {
+        LeaseStatus { version: ABI_VERSION, state, generation: 7,
+                      owned_maps: maps, inflight_shares: inflight, last_errno: 0 }
+    }
+
+    #[test]
+    fn legacy_caps_and_partial_features_are_refused_before_share() {
+        for bits in 0..REQUIRED_FEATURES {
+            assert!(!LeaseCaps { version: 1, reserved: 0, features: bits }.supports_owner_fence());
+        }
+        assert!(LeaseCaps { version: 1, reserved: 0, features: 0x1f }.supports_owner_fence());
+        assert!(!LeaseCaps { version: 2, reserved: 0, features: 0xf }.supports_owner_fence());
+    }
+
+    #[test]
+    fn zero_maps_and_elapsed_wait_do_not_complete_a_closing_lease() {
+        let mut tracker = CompletionTracker::new(Some(7));
+        tracker.requested_close();
+        for _ in 0..100 { assert_eq!(tracker.observe(status(CLOSING, 0, 0)), Completion::Pending); }
+    }
+
+    #[test]
+    fn only_complete_after_all_owned_resources_and_inflight_shares_finish() {
+        let mut tracker = CompletionTracker::new(Some(7));
+        tracker.requested_close();
+        assert_eq!(tracker.observe(status(CLOSING, 1, 0)), Completion::Pending);
+        assert_eq!(tracker.observe(status(CLOSING, 0, 1)), Completion::Pending);
+        assert_eq!(tracker.observe(status(COMPLETE, 0, 0)), Completion::Complete);
+    }
+
+    #[test]
+    fn stalled_and_unknown_identity_never_acknowledge_completion() {
+        let mut tracker = CompletionTracker::new(Some(7));
+        tracker.requested_close();
+        assert!(matches!(tracker.observe(status(STALLED, 1, 0)), Completion::Hold(_)));
+        let mut wrong = status(COMPLETE, 0, 0);
+        wrong.generation = 8;
+        assert!(matches!(tracker.observe(wrong), Completion::Hold(_)));
+        assert!(matches!(tracker.observe(status(COMPLETE, 0, 0)), Completion::Hold(_)));
+    }
+
+    #[test]
+    fn misleading_complete_with_an_owned_map_is_a_permanent_contract_failure() {
+        let mut tracker = CompletionTracker::new(Some(7));
+        tracker.requested_close();
+        assert!(matches!(tracker.observe(status(COMPLETE, 1, 0)), Completion::Hold(_)));
+        assert!(matches!(tracker.observe(status(COMPLETE, 0, 0)), Completion::Hold(_)));
+    }
+}
