diff --git a/patches/drivers/ArmDTPlatform-droidvm-psci.patch b/patches/drivers/ArmDTPlatform-droidvm-psci.patch
new file mode 100644
--- /dev/null
+++ b/patches/drivers/ArmDTPlatform-droidvm-psci.patch
@@ -0,0 +1,53 @@
+--- a/ArmDTPlatform.cpp
++++ b/ArmDTPlatform.cpp
+@@ -18,6 +18,7 @@
+ #include <libkern/c++/OSData.h>
+ #include <libkern/c++/OSIterator.h>
