++}
++
++int ArmDTPlatform::haltRestart (unsigned int type)
++{
++  // Normal OS shutdown/restart must reach the VMM. Panic and sync requests
++  // retain the inherited diagnostic behavior.
++  if (type != kPEHaltCPU && type != kPERestartCPU) {
++    return IODTPlatformExpert::haltRestart (type);
++  }
++  DTEntry psci = nullptr;
++  const void *method = nullptr;
++  unsigned int size = 0;
++  bool useSMC = SecureDTLookupEntry (nullptr, "/psci", &psci) == kSuccess &&
++                SecureDTGetProperty (psci, "method", &method, &size) == kSuccess &&
++                size >= 3 && memcmp (method, "smc", 3) == 0;
++  // DroidVM's generated PSCI node selects HVC; preserve an explicit SMC.
++  register uint64_t x0 __asm__ ("x0") = type == kPEHaltCPU ? 0x84000008 : 0x84000009;
++  register uint64_t x1 __asm__ ("x1") = 0;
++  register uint64_t x2 __asm__ ("x2") = 0;
++  register uint64_t x3 __asm__ ("x3") = 0;
++  if (useSMC) {
++    __asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3) : : "memory");
++  } else {
++    __asm__ volatile ("hvc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3) : : "memory");
++  }
++  IOLog ("ArmDTPlatform: PSCI %s unexpectedly returned 0x%llx\n",
++         type == kPEHaltCPU ? "SYSTEM_OFF" : "SYSTEM_RESET", (unsigned long long)x0);
++  return -1;
+ }
