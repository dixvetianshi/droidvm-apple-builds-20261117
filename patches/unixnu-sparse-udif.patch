+    def write_raw(self, destination):
+        """Write the parsed raw bytes without allocating zero spans; return (size, SHA-256)."""
+        # SystemOS is often already raw. APFS cloning preserves that existing
+        # representation without allocating another complete copy on this build Mac.
+        cloned = self.chunks is None and sys.platform == 'darwin'
+        if cloned:
+            subprocess.run(['cp', '-c', str(self.path), str(destination)], check=True)
+        digest, size = hashlib.sha256(), 0
+        if cloned:
+            for block in self.blocks():
+                digest.update(block)
+                size += len(block)
+        else:
+            with open(destination, 'wb') as target:
+                for block in self.blocks():
+                    digest.update(block)
+                    if block.strip(b'\0'):
+                        target.write(block)
+                    else:
+                        target.seek(len(block), 1)
+                    size += len(block)
+                target.truncate(size)
+        return size, digest.hexdigest()
