+struct late_pin_arg {
+	struct page *pg;
+	pthread_barrier_t past_windows, allow_put, put_done;
+};
+
+/* Unlike the stress thread, this driver only executes queued timer work. */
+static int late_pin_queued_tick(void)
+{
+	int i;
+
+	if (!GH_READ_ONCE(mock_release_pending))
+		return 0;
+	GH_WRITE_ONCE(mock_release_pending, 0);
+	__atomic_fetch_add(&mock_now_sec, 1, __ATOMIC_RELAXED);
+	gh_release_round();
+	for (i = 0; i < 5000 && GH_READ_ONCE(gh_adjust_g_active); i++) {
+		GH_WRITE_ONCE(mock_adjust_pending, 0);
+		gh_adjust_round();
+	}
+	CHECK(!GH_READ_ONCE(gh_adjust_g_active), "R5 triggered adjust converged");
+	return 1;
+}
+
+static void *late_pin_guest_thread(void *arg)
+{
+	struct late_pin_arg *a = arg;
+
+	pthread_barrier_wait(&a->past_windows);
+	pthread_barrier_wait(&a->allow_put);
+	put_page(a->pg);
+	pthread_barrier_wait(&a->put_done);
+	return NULL;
+}
+
+static void *late_pin_release_thread(void *arg)
+{
+	struct late_pin_arg *a = arg;
+	int i;
+
+	for (i = 0; i < 14; i++)
+		CHECK(late_pin_queued_tick(), "R5 pre-unpin timer %d was queued", i);
+	pthread_barrier_wait(&a->past_windows);
+	pthread_barrier_wait(&a->allow_put);
+	/* This callback deliberately races the external 2->1 put. */
+	CHECK(late_pin_queued_tick(), "R5 racing collector was already queued");
+	pthread_barrier_wait(&a->put_done);
+	for (i = 0; i < 30 && gh_release_active(); i++)
+		CHECK(late_pin_queued_tick(), "R5 late collector %d was queued", i);
+	CHECK(!gh_release_active(), "R5 timer stops once the external pin returns");
+	return NULL;
+}
