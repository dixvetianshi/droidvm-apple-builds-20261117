+fn validate_direct_decoder_host_params(limit: u32, msm_prime: &str) -> Result<()> {
+    if limit < 16384 {
+        bail!("read-only direct decoder requires existing udmabuf list_limit >= 16384, found {limit}");
+    }
+    if !matches!(msm_prime.trim(), "Y" | "1") {
+        bail!(
+            "read-only direct decoder requires existing udmabuf msm_prime enabled, found {:?}",
+            msm_prime.trim()
+        );
+    }
+    Ok(())
+}
+
+/// Prepare mode retains the existing global setup; ReadOnly observes capabilities only.
+#[cfg(feature = "media")]
+fn prepare_direct_decoder_udmabuf(policy: HostMemoryPolicy) -> Result<()> {
+    if policy == HostMemoryPolicy::Prepare {
+        raise_udmabuf_list_limit(16384);
+        enable_udmabuf_msm_prime();
+        return Ok(());
+    }
+
+    let limit = std::fs::read_to_string("/sys/module/udmabuf/parameters/list_limit")
+        .context("read-only direct decoder cannot read existing udmabuf list_limit")?
+        .trim()
+        .parse::<u32>()
+        .context("read-only direct decoder found invalid udmabuf list_limit")?;
+    let path = udmabuf_msm_prime_path()
+        .context("read-only direct decoder requires existing udmabuf msm_prime capability")?;
+    let msm_prime = std::fs::read_to_string(&path)
+        .with_context(|| format!("read-only direct decoder cannot read {}", path.display()))?;
+    validate_direct_decoder_host_params(limit, &msm_prime)?;
+    info!("read-only direct decoder: existing udmabuf capabilities verified; no module parameters changed");
+    Ok(())
+}
