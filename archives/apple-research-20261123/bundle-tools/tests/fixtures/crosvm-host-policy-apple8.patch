+    /// Find a unique subrange of this VM's original shmem mappings. Dup fds retain dev/inode
+    /// identity; fd numbers, display names and guest addresses do not prove backing ownership.
+    fn owned_memfd_range(
+        &self,
+        fd: &dyn AsRawDescriptor,
+        offset: u64,
+        size: u64,
+    ) -> Result<Option<usize>> {
+        let source = base::linux::fstat(&base::Descriptor(fd.as_raw_descriptor()))?;
+        let mut owned = false;
+        let mut found = None;
+        for region in self.guest_mem.regions() {
+            if !matches!(region.shm, vm_memory::BackingObject::Shm(_)) {
+                continue;
+            }
+            let backing = base::linux::fstat(region.shm)?;
+            if source.st_dev != backing.st_dev || source.st_ino != backing.st_ino {
+                continue;
+            }
+            owned = true;
+            if let Some(addr) = owned_mapping_subrange(
+                region.host_addr, region.shm_offset, region.size as u64, offset, size,
+            )? {
+                if found.replace(addr).is_some() {
+                    return Err(Error::new(EEXIST));
+                }
+            }
+        }
+        if owned && found.is_none() {
+            return Err(Error::new(EINVAL));
+        }
+        Ok(found)
+    }
