+        const SAMPLE: u32 = 2 << 20;
+        assert!(validate_sample_coverage(SAMPLE as u64 * 2, 2, SAMPLE).is_ok());
+        assert!(validate_sample_coverage(SAMPLE as u64 + 1, 2, SAMPLE).is_ok());
+        assert!(validate_sample_coverage(SAMPLE as u64 * 2, 1, SAMPLE).is_err());
+        assert!(validate_sample_coverage(SAMPLE as u64 * 2, 3, SAMPLE).is_err());
+        assert!(validate_sample_coverage(SAMPLE as u64, 1, 0).is_err());
+        assert!(validate_sample_coverage(SAMPLE as u64, 1, SAMPLE / 2).is_err());
+        assert!(validate_sample_coverage(0, 0, SAMPLE).is_err());
+    }
