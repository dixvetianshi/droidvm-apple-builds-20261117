+// Resolve file offsets only within one owner mapping. File identity is checked by the caller;
+// this boundary owns range arithmetic and the VA/file-offset alignment required by COLLAPSE.
+fn owned_mapping_subrange(
+    host_addr: usize,
+    region_offset: u64,
+    region_size: u64,
+    offset: u64,
+    size: u64,
+) -> Result<Option<usize>> {
+    const THP_SIZE: u64 = 2 << 20;
+    if size == 0 || size % THP_SIZE != 0 || offset % THP_SIZE != 0 {
+        return Err(Error::new(EINVAL));
+    }
+    let end = offset.checked_add(size).ok_or(Error::new(EOVERFLOW))?;
+    let region_end = region_offset.checked_add(region_size).ok_or(Error::new(EOVERFLOW))?;
+    if offset < region_offset || end > region_end {
+        return Ok(None);
+    }
+    let delta = usize::try_from(offset - region_offset).map_err(|_| Error::new(EOVERFLOW))?;
+    let addr = host_addr.checked_add(delta).ok_or(Error::new(EOVERFLOW))?;
+    let length = usize::try_from(size).map_err(|_| Error::new(EOVERFLOW))?;
+    addr.checked_add(length).ok_or(Error::new(EOVERFLOW))?;
+    if addr == 0 || addr % THP_SIZE as usize != 0 {
+        return Err(Error::new(EINVAL));
+    }
+    Ok(Some(addr))
 }
 
