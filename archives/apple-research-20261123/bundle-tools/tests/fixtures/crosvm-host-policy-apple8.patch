+#[cfg(test)]
+mod local_memory_range_tests {
+    use super::*;
+
+    #[test]
+    fn owned_range_preserves_file_offset_and_rejects_cross_region() {
+        const THP: u64 = 2 << 20;
+        let hva = (4 * THP) as usize;
