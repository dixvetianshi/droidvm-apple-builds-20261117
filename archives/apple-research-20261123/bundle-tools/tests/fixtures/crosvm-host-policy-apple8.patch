+
+fn validate_sample_coverage(size: u64, samples: u64, sample_bytes: u32) -> std::result::Result<(), String> {
+    const SAMPLE_BYTES: u64 = 2 << 20;
+    let expected = if size == 0 { 0 } else { (size - 1) / SAMPLE_BYTES + 1 };
+    if expected == 0 || sample_bytes as u64 != SAMPLE_BYTES || samples != expected {
+        return Err(format!(
+            "incomplete pin probe coverage: {samples} samples at {sample_bytes} bytes, expected {expected} at {SAMPLE_BYTES} bytes",
+        ));
+    }
+    Ok(())
+}
